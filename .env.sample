# motd 环境变量示例
#
# 用法：复制本文件为 .env，按需修改即可——程序启动时会**自动加载**当前工作
# 目录（找不到再看可执行文件所在目录）的 .env，无需手动 source。
# 进程已有的环境变量优先，.env 只填空缺；完全不希望自动加载时设
# MOTD_DOTENV_DISABLED=true（建议由 systemd Environment= 注入，而非写进本文件）。
# .env 含凭据、已被 .gitignore 排除；本示例文件可以安全提交。
#
# 约定：所有变量以 MOTD_ 前缀；**空值 = 未设置 = 回落到默认值**。
# 因此想用默认值时，直接注释掉该行或留空即可，不必猜默认怎么写。
# 默认值事实来源：internal/config/config.go（服务）与 scripts/*.sh（脚本）。

# ─────────────────────────────────────────────────────────────────────────────
# 数据位置
# ─────────────────────────────────────────────────────────────────────────────

# 数据根目录：SQLite 库、SSH host key、备份都放这里。
# 默认 ./data。改这里会让服务去找新目录；换目录时记得把原 host key 一起搬过去，
# 否则客户端会报 host key changed。
MOTD_DATA_DIR=./data

# SQLite 库路径，默认 $MOTD_DATA_DIR/motd.db。
# 一般不用改；需要把库放到别的盘时再设。备份脚本 backup.sh 也读这个变量。
MOTD_DB_PATH=./data/motd.db

# 备份输出目录（仅 backup.sh / restore.sh 使用），默认 ./data/backups。
MOTD_BACKUP_DIR=./data/backups

# 备份恢复工具路径（仅 backup.sh / restore.sh 使用），默认 ./bin/motdctl。
# 先执行 go build -o bin/motdctl ./cmd/motdctl，或用绝对路径指定。
MOTDCTL_BIN=./bin/motdctl

# ─────────────────────────────────────────────────────────────────────────────
# 监听地址
# ─────────────────────────────────────────────────────────────────────────────

# 运维探针 /healthz，默认 127.0.0.1:8080，只绑本机、不承载业务流量。
# 需从别的机器探活时才改成 0.0.0.0:8080，并自行做好防火墙。
MOTD_HTTP_ADDR=127.0.0.1:8080

# SSH 入口，默认 :2222（即 0.0.0.0:2222）。仅公钥认证、禁 root、禁密码。
# 对外 22 → 2222 的转发由部署方完成，不在本程序内。
MOTD_SSH_ADDR=:2222

# 最大并发 SSH 连接数，默认 100。满员时新连接在握手前收到明文拒绝。
MOTD_SSH_MAX_CONNS=100

# 会话空闲超时，默认 10m。写法用 Go duration：30s / 5m / 1h。
MOTD_SSH_IDLE_TIMEOUT=10m

# ─────────────────────────────────────────────────────────────────────────────
# 日志
# ─────────────────────────────────────────────────────────────────────────────

# 日志级别，默认 info；可选 debug / info / warn / error。填错服务拒绝启动。
MOTD_LOG_LEVEL=info

# 日志格式，默认 text；可选 text / json。接日志采集系统可用 json。
MOTD_LOG_FORMAT=text

# ─────────────────────────────────────────────────────────────────────────────
# GitHub Device Flow 登录
# ─────────────────────────────────────────────────────────────────────────────

# OAuth App 的 client_id，默认空。留空时 /login github 返回明确提示，不 panic。
# 换 token 不需要 client_secret；**任何情况下都不要把 secret 写进本文件**。
# 注入方式（systemd）：EnvironmentFile=/opt/motd/.env，文件 0600 root:root。
# 出站需放行 github.com:443 与 api.github.com:443。
MOTD_GITHUB_CLIENT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# 认证安全（P1-M2）
# ─────────────────────────────────────────────────────────────────────────────

# 认证限流：窗口内允许的最大失败/尝试次数，默认 5。
# 四类场景共用：login_failure / device_start / key_binding / verify。
MOTD_AUTH_LIMIT_MAX_FAILURES=5

# 认证限流：滑动窗口长度，默认 5m。
MOTD_AUTH_LIMIT_WINDOW=5m

# 认证限流：超限后的锁定时长，默认 15m。锁定期内所有认证动作直接拒绝。
MOTD_AUTH_LIMIT_LOCKOUT=15m

# 认证限流：内存键上限，默认 4096，超限淘汰最旧，防随机 IP 打爆内存。
# 注意：计数纯内存，进程重启清零、多实例不共享。
MOTD_AUTH_LIMIT_MAX_KEYS=4096

# 审计 events 的环形缓冲容量，默认 512。写满后认证动作 fail-closed（拒绝），
# 并递增 /healthz 的 audit_dropped —— 该值 >0 应立即告警。
MOTD_AUDIT_CAPACITY=512

# 审计批量落库周期，默认 1s。落库走写队列，application 层不持有定时器。
MOTD_AUDIT_FLUSH_INTERVAL=1s

# .env 自动加载开关，默认 false（即默认开启自动加载）。
# 设为 true 时程序完全不读 .env，只从进程环境变量取配置——适合 systemd
# 全靠 EnvironmentFile= 注入凭据、不希望旁路文件参与的场景。
# 注意：由本文件自身设置该开关要到下次启动才生效，请从外部注入。
# MOTD_DOTENV_DISABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# 邮箱注册/登录/找回（P1-M5，v0.3.0-email）
# ─────────────────────────────────────────────────────────────────────────────
# 默认关闭； MOTD_EMAIL_ENABLED=true 时才逐项校验下列变量，缺哪项报哪项。
# 授权码（MOTD_SMTP_PASS）只从 .env（0600，已被 .gitignore 排除）读入进程内存，
# 绝不写进仓库、日志或 systemd unit；请用邮箱「授权码」而非登录密码。
MOTD_EMAIL_ENABLED=false
MOTD_SMTP_HOST=smtp.163.com
MOTD_SMTP_PORT=465
MOTD_SMTP_USER=your_account@163.com
MOTD_SMTP_PASS=your_authorization_code
MOTD_EMAIL_FROM=your_account@163.com
